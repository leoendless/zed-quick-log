{
  "name": "quick-log-lsp",
  "version": "0.0.1",
  "description": "Language server that provides 'Insert console.log' code actions for JS/TS files. Designed for the Quick Log Zed extension.",
  "main": "dist/server.js",
  "bin": {
    "quick-log-lsp": "dist/server.js"
  },
  "files": [
    "dist/server.js"
  ],
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --target=node18 --outfile=dist/server.js --banner:js=\"#!/usr/bin/env node\"",
    "watch": "npm run build -- --watch",
    "test": "npm run build && node --test test/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leoendless/zed-quick-log.git",
    "directory": "server"
  },
  "keywords": ["lsp", "language-server", "console-log", "javascript", "typescript", "zed"],
  "author": "leoendless",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11",
    "vscode-uri": "^3.0.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5"
  }
}
